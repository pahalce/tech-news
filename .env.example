DISCORD_BOT_TOKEN=
DISCORD_CHANNEL_ID=

# LLM calls go through the Vercel AI SDK.
# LLM_PROVIDER can be gemini, openai, or openai-compatible.
# OpenAI: set OPENAI_API_KEY or LLM_API_KEY.
# Gemini: set GEMINI_API_KEY, GOOGLE_GENERATIVE_AI_API_KEY, or LLM_API_KEY.
# OpenAI-compatible: set LLM_API_KEY and LLM_BASE_URL.
LLM_PROVIDER=gemini
GEMINI_API_KEY=
# OPENAI_API_KEY=
# LLM_API_KEY=
# LLM_BASE_URL=

LLM_MODEL=gemini-2.5-flash
# LLM_REQUEST_TIMEOUT_MS=90000
# HTTP_REQUEST_TIMEOUT_MS=20000
# FEATURE_EXTRACTION_MODEL=
# RECOMMENDATION_CONTENT_MODEL=
# RERANK_MODEL=
# PREFERENCE_SUMMARY_MODEL=
# VOCABULARY_SUGGESTION_MODEL=
